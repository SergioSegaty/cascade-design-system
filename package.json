{
  "name": "cascade-ds",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "format-theme": "pnpm prettier ./packages/styles/theme.js --write --ignore-path",
    "build": "pnpm style-build && pnpm --filter @cascade-ds/components run build",
    "build:style": "pnpm --filter generator run build && pnpm format-theme",
    "clean:build": "rimraf --glob \"packages/*/dist\" packages/styles/index.css packages/styles/theme.d.ts packages/styles/theme.js",
    "test": "vitest",
    "test:storybook": "pnpm --filter storybook test",
    "test:coverage": "vitest --coverage",
    "storybook": "pnpm --filter storybook run storybook",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-istanbul": "4.1.11",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "rimraf": "^6.1.3",
    "style-dictionary": "^5.5.0",
    "tsx": "^4.23.0",
    "typescript-eslint": "^8.62.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  }
}